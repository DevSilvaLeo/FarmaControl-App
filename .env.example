# URL base da API do FarmaControl (ver .spec/02 §2.6). Sem barra final.
VITE_API_BASE_URL=http://localhost:5138/api

# Nome exibido no topbar / título da aba.
VITE_APP_NOME=FarmaControl

# 'off' desliga o mock de permissões em desenvolvimento (usePermissao libera tudo
# enquanto não há login real — Etapa 3). Qualquer outro valor / ausente = mock ligado.
VITE_PERMISSOES_MOCK=on
