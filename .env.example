# Base da API. Padrão do código: "/api" (mesma origem).
#  - Em `npm run dev` o Vite faz proxy de /api -> http://localhost:5138
#    (ajuste o alvo com a env API_PROXY_TARGET).
#  - No container o Nginx faz o proxy (env BACKEND_URL do docker-compose).
# Descomente só se precisar apontar para uma URL absoluta (exige CORS no backend):
# VITE_API_BASE_URL=http://localhost:5138/api

# Nome exibido no rodapé do login / título.
VITE_APP_NOME=FarmaControl

# 'off' desliga o mock de permissões em desenvolvimento (usePermissao libera tudo
# enquanto não há login real). Qualquer outro valor / ausente = mock ligado.
# Obs.: o mock só age em build de desenvolvimento (import.meta.env.DEV).
VITE_PERMISSOES_MOCK=on
