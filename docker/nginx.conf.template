# Renderizado no start pela imagem oficial do Nginx (envsubst) — só ${BACKEND_URL}
# é substituído; as variáveis do próprio Nginx ($uri, $host, ...) ficam intactas
# porque não existem no ambiente.

server {
    listen       80;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # Comprime respostas de texto.
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # O shell e a config de runtime nunca são cacheados.
    location = /index.html { add_header Cache-Control "no-store"; }
    location = /env.js     { add_header Cache-Control "no-store"; }

    # Assets com hash no nome → cache longo e imutável.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Proxy da API → backend. Evita CORS (o backend não o configura, .spec/04 §4.2):
    # o browser fala com /api na MESMA origem do frontend.
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # SPA: qualquer rota desconhecida devolve o index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
